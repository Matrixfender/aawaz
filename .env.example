# Required: Sarvam AI API Key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Required for Authentication & Multi-device DB: Supabase (https://supabase.com)
# If omitted, Aawaz runs automatically in local demo mode with localStorage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Enable Google OAuth button on login/signup
NEXT_PUBLIC_ENABLE_GOOGLE=false

# Optional: Sarvam Model Configurations (defaults are pre-configured to official recommended models)
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=meera
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
