# Required: Your Sarvam AI Subscription Key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Sarvam Model Configurations (defaults are pre-configured to the official recommended models)
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=meera
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
